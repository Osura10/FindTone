# ---- Choose the LLM provider ----
# ollama = local testing (free, no limits)   gemini = hosting / final demo
LLM_PROVIDER=ollama

# Gemini (only needed when LLM_PROVIDER=gemini)
GOOGLE_API_KEY=your_gemini_api_key_here

# Postgres direct read connection for AI agents (must be URI format)
# postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URI=postgresql://user:pass@host:5432/postgres?sslmode=require

# Optional overrides (defaults shown)
# OLLAMA_CHAT_MODEL=llama3.1:8b
# OLLAMA_VISION_MODEL=gemma3:4b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# GEMINI_CHAT_MODEL=gemini-3.6-flash
# GEMINI_VISION_MODEL=gemini-3.6-flash



# Enable CLIP zero-shot image classification check
ENABLE_CLIP=true
