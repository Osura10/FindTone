# Copy to .env and fill in. Never commit the real .env.
# Postgres (Supabase) connection string in URI form
DATABASE_URI=postgresql://postgres:<password>@<host>:5432/postgres?sslmode=require
# Cloudinary for listing photos and profile images
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Python AI service
AI_SERVICE_URL=http://127.0.0.1:8000
# Optional shared secret, must equal X_INTERNAL_KEY in ai-service/.env
AI_INTERNAL_KEY=
